<?xml version="1.0" encoding="utf-8"?>
<!-- Shows only the streak and a prompt, never journal text: the home
     screen is visible to anyone holding the phone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_journal_bg"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/widget_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_subtitle"
        android:textColor="#F0EEFF"
        android:textSize="13sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="8dp" />
    <!-- Quick capture: one tap opens a new entry with this mood chosen. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/widget_mood_happy"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="😊"
            android:textSize="22sp"
            android:contentDescription="@string/widget_mood_happy"
            android:background="@drawable/widget_mood_bg"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/widget_mood_peaceful"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="😇"
            android:textSize="22sp"
            android:contentDescription="@string/widget_mood_peaceful"
            android:background="@drawable/widget_mood_bg"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/widget_mood_neutral"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="😐"
            android:textSize="22sp"
            android:contentDescription="@string/widget_mood_neutral"
            android:background="@drawable/widget_mood_bg"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/widget_mood_anxious"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="😰"
            android:textSize="22sp"
            android:contentDescription="@string/widget_mood_anxious"
            android:background="@drawable/widget_mood_bg"
            android:layout_marginHorizontal="2dp" />

        <TextView
            android:id="@+id/widget_mood_sad"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="😢"
            android:textSize="22sp"
            android:contentDescription="@string/widget_mood_sad"
            android:background="@drawable/widget_mood_bg"
            android:layout_marginHorizontal="2dp" />
    </LinearLayout>
</LinearLayout>
