<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Universal links for https://nabd.app/journal and /garden. Belongs in
         the entitlements, not Info.plist; reference this file from the Runner
         target's CODE_SIGN_ENTITLEMENTS once the Xcode project exists. -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>applinks:nabd.app</string>
    </array>
</dict>
</plist>
