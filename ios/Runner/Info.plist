<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <!-- The brand name, not the old working title. The Arabic UI shows نبض
         inside the app; the icon label stays the Latin brand like the store
         listing, because a per-language label needs InfoPlist.strings in the
         Xcode project. -->
    <key>CFBundleDisplayName</key>
    <string>Nabd</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Nabd</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>ar</string>
        <string>bn</string>
        <string>de</string>
        <string>en</string>
        <string>es</string>
        <string>fa</string>
        <string>fr</string>
        <string>hi</string>
        <string>id</string>
        <string>it</string>
        <string>ja</string>
        <string>ko</string>
        <string>ms</string>
        <string>pt</string>
        <string>ru</string>
        <string>tr</string>
        <string>uk</string>
        <string>ur</string>
        <string>vi</string>
        <string>zh</string>
    </array>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- Permissions -->
    <key>NSCameraUsageDescription</key>
    <string>نبض يحتاج الكاميرا لإضافة صور إلى مذكراتك</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>نبض يحتاج الوصول للصور لإضافتها لمذكراتك</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>نبض يحتاج الميكروفون لتسجيل ملاحظات صوتية</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>نبض يحتاج التعرف على الصوت لتحويل كلامك إلى نص</string>
    <key>NSFaceIDUsageDescription</key>
    <string>نبض يستخدم Face ID لقفل مذكراتك الخاصة</string>

    <!-- URL Scheme -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>app.nabd.journal</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>nabd</string>
            </array>
        </dict>
    </array>

</dict>
</plist>
